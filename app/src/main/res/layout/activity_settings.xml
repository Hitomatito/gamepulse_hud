<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@drawable/bg_main_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_activity_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:shadowColor="#8022D3EE"
            android:shadowRadius="24"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:maxWidth="600dp" />

        <!-- Reset Button - Positioned prominently -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginBottom="24dp"
            android:paddingHorizontal="32dp"
            android:text="@string/reset_settings"
            android:textColor="@color/game_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:elevation="0dp"
            app:background="@drawable/bg_btn_reset"
            app:backgroundTint="@null"
            app:rippleColor="@android:color/transparent"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/game_red"
            app:iconPadding="10dp"
            app:iconGravity="textStart" />

        <!-- Text Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxWidth="600dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/game_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_settings"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/game_cyan"
                    android:shadowColor="#8022D3EE"
                    android:shadowRadius="20"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_text_format"
                    app:drawableTint="?attr/colorPrimary"
                    android:drawablePadding="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Text Size -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_size_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarTextSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="20" />

                    <TextView
                        android:id="@+id/tvTextSizeValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_size_default"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Text Color -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_color_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <!-- Color Sliders -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:text="@string/color_red"
                            android:textColor="#FF0000"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekBarColorRed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="255" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:text="@string/color_green"
                            android:textColor="#00FF00"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekBarColorGreen"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="255" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="wrap_content"
                            android:text="@string/color_blue"
                            android:textColor="#0000FF"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekBarColorBlue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="255"
                            android:progress="255" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Color Preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/color_preview_label"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <View
                        android:id="@+id/viewColorPreview"
                        android:layout_width="60dp"
                        android:layout_height="30dp"
                        android:background="#FFFFFF"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Font Style Configuration -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_style_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/spinner_background">

                    <Spinner
                        android:id="@+id/spinnerFontStyle"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_dropdown_bg" />
                </FrameLayout>

                <!-- Font Weight Configuration -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_weight_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/spinner_background">

                    <Spinner
                        android:id="@+id/spinnerFontWeight"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_dropdown_bg" />
                </FrameLayout>

                <!-- Font Sample Text -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_preview_title"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFontSample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/font_sample_text"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:padding="12dp"
                    android:background="@drawable/sample_text_background"
                    android:gravity="center" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Display Options Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxWidth="600dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/game_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/display_items_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/game_cyan"
                    android:shadowColor="#8022D3EE"
                    android:shadowRadius="20"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_dashboard"
                    app:drawableTint="?attr/colorPrimary"
                    android:drawablePadding="8dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_fps_setting"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowFps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_fps_chart_setting"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowFpsChart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_cpu_temp_setting"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowCpuTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_gpu_temp_setting"
                        android:textColor="?attr/colorOnSurface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowGpuTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Appearance Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxWidth="600dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/game_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/appearance_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/game_cyan"
                    android:shadowColor="#8022D3EE"
                    android:shadowRadius="20"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_palette"
                    app:drawableTint="?attr/colorPrimary"
                    android:drawablePadding="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Background Opacity -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/background_opacity_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarBackgroundOpacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="80" />

                    <TextView
                        android:id="@+id/tvBackgroundOpacityValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="@string/background_opacity_default"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Corner Radius -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/corner_radius_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarCornerRadius"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="50"
                        android:progress="8" />

                    <TextView
                        android:id="@+id/tvCornerRadiusValue"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="@string/corner_radius_default"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Position Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:maxWidth="600dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/game_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/position_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/game_cyan"
                    android:shadowColor="#8022D3EE"
                    android:shadowRadius="20"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_place"
                    app:drawableTint="?attr/colorPrimary"
                    android:drawablePadding="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Position X -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/position_x_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarPositionX"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="100" />

                    <TextView
                        android:id="@+id/tvPositionXValue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/position_x_default"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Position Y -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/position_y_setting"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarPositionY"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="2000"
                        android:progress="300" />

                    <TextView
                        android:id="@+id/tvPositionYValue"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="@string/position_y_default"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
