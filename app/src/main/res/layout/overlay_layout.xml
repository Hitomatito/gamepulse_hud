<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- FPS History Chart -->
    <com.hitomatito.gamepulse_hud.overlay.MetricsChartView
        android:id="@+id/fpsChart"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:minWidth="168dp"
        android:layout_marginBottom="10dp" />

    <!-- FPS Display -->
    <LinearLayout
        android:id="@+id/fps_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txtFPS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            app:drawableStartCompat="@drawable/ic_fps"
            android:drawablePadding="6dp"
            tools:text="FPS: 60" />
    </LinearLayout>

    <!-- CPU Temperature Display -->
    <LinearLayout
        android:id="@+id/cpu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/txtCPU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            app:drawableStartCompat="@drawable/ic_cpu"
            android:drawablePadding="6dp"
            tools:text="CPU: 45.0°C" />
    </LinearLayout>

    <!-- GPU Temperature Display -->
    <LinearLayout
        android:id="@+id/gpu_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtGPU"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/overlay_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2"
            app:drawableStartCompat="@drawable/ic_gpu"
            android:drawablePadding="6dp"
            tools:text="GPU: 55.0°C" />
    </LinearLayout>

</LinearLayout>