<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_screen"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Soportes de esquina del marco -->
    <ImageView
        android:id="@+id/bracketTopLeft"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_corner_bracket"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bracketTopRight"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:rotation="90"
        android:src="@drawable/ic_corner_bracket"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bracketBottomRight"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:rotation="180"
        android:src="@drawable/ic_corner_bracket"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/bracketBottomLeft"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:rotation="270"
        android:src="@drawable/ic_corner_bracket"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Aura de neón (detrás de la placa y del título) -->
    <ImageView
        android:id="@+id/auraGlow"
        android:layout_width="288dp"
        android:layout_height="288dp"
        android:src="@drawable/bg_aura"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@id/imgAppIcon"
        app:layout_constraintEnd_toEndOf="@id/imgAppIcon"
        app:layout_constraintTop_toTopOf="@id/imgAppIcon"
        app:layout_constraintBottom_toBottomOf="@id/imgAppIcon" />

    <!-- Placa de icono -->
    <ImageView
        android:id="@+id/imgAppIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:padding="24dp"
        android:src="@drawable/ic_app"
        android:contentDescription="@string/app_icon_desc"
        android:background="@drawable/bg_icon_plate"
        app:tint="@color/game_cyan"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/game_text_primary"
        android:textAllCaps="true"
        android:gravity="center"
        android:shadowColor="#8022D3EE"
        android:shadowRadius="28"
        android:layout_marginTop="24dp"
        android:maxWidth="600dp"
        app:layout_constraintTop_toBottomOf="@id/imgAppIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subrayado decorativo -->
    <View
        android:id="@+id/titleUnderline"
        android:layout_width="120dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_underline"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/tvAppDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_description"
        android:textSize="13sp"
        android:textColor="@color/game_text_dim"
        android:textAllCaps="true"
        android:letterSpacing="0.1"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:maxWidth="600dp"
        app:layout_constraintTop_toBottomOf="@id/titleUnderline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tarjeta de estado -->
    <FrameLayout
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:maxWidth="600dp"
        android:background="@drawable/bg_game_card"
        app:layout_constraintTop_toBottomOf="@id/tvAppDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Barra de acento superior -->
            <View
                android:id="@+id/accentBar"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:background="@drawable/bg_accent_bar" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <View
                    android:id="@+id/imgStatusDot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/bg_status_dot"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hud_status_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/game_text_dim"
                    android:textAllCaps="true"
                    android:letterSpacing="0.14" />

                <!-- Ecualizador animado -->
                <LinearLayout
                    android:id="@+id/eqContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginStart="12dp">

                    <View
                        android:id="@+id/eqBar1"
                        android:layout_width="4dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_eq_bar" />
                    <View
                        android:id="@+id/eqBar2"
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_eq_bar" />
                    <View
                        android:id="@+id/eqBar3"
                        android:layout_width="4dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_eq_bar" />
                    <View
                        android:id="@+id/eqBar4"
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_eq_bar" />
                    <View
                        android:id="@+id/eqBar5"
                        android:layout_width="4dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_eq_bar" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hud_status_starting"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/game_cyan"
                android:shadowColor="#8022D3EE"
                android:shadowRadius="18"
                android:layout_marginTop="6dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Contenedor de botones -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="600dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón Configuración (con glow detrás) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/settingsGlow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_aura"
                android:contentDescription="@null"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_settings"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/game_text_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:elevation="0dp"
                app:background="@drawable/bg_btn_settings"
                app:backgroundTint="@null"
                app:rippleColor="@android:color/transparent"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/game_text_primary"
                app:iconPadding="10dp"
                app:iconGravity="textStart" />
        </FrameLayout>

        <!-- Botón Iniciar/Detener HUD (con glow animado detrás) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/toggleGlow"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_aura_green"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleHUD"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/toggle_hud_start"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/game_text_primary"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:elevation="0dp"
                app:background="@drawable/bg_btn_start"
                app:backgroundTint="@null"
                app:rippleColor="@android:color/transparent"
                app:icon="@drawable/ic_play"
                app:iconTint="@color/game_text_primary"
                app:iconPadding="10dp"
                app:iconGravity="textStart" />
        </FrameLayout>

        <!-- Botón Salir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_exit"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/game_text_primary"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:elevation="0dp"
            app:background="@drawable/bg_btn_exit"
            app:backgroundTint="@null"
            app:rippleColor="@android:color/transparent"
            app:icon="@drawable/ic_exit"
            app:iconTint="@color/game_red"
            app:iconPadding="10dp"
            app:iconGravity="textStart" />

    </LinearLayout>

    <!-- Barrido de escaneo decorativo (no bloquea el toque en botones) -->
    <View
        android:id="@+id/scanline"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_scanline"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pie -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_footer"
        android:textSize="11sp"
        android:textColor="@color/game_text_dim"
        android:textAllCaps="true"
        android:letterSpacing="0.16"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>