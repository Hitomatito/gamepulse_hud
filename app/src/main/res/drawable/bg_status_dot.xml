<?xml version="1.0" encoding="utf-8"?>
<!-- Punto de estado: núcleo verde + halo suave -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#4D4ADE80" />
        </shape>
    </item>
    <!-- Núcleo -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/game_green" />
        </shape>
    </item>
</layer-list>