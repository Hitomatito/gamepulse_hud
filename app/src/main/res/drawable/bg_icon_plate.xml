<?xml version="1.0" encoding="utf-8"?>
<!-- Placa trasera del icono: anillo neón + círculo interior -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Anillo exterior -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#8022D3EE" />
        </shape>
    </item>
    <!-- Disco interior -->
    <item
        android:left="9dp"
        android:top="9dp"
        android:right="9dp"
        android:bottom="9dp">
        <shape android:shape="oval">
            <solid android:color="@color/game_card_bg" />
            <stroke
                android:width="1dp"
                android:color="#4D38BDF8" />
        </shape>
    </item>
</layer-list>